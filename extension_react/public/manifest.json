{
  "manifest_version": 3,
  "name": "DOM Scraper Extension",
  "version": "1.0",
  "description": "Extracts and minifies DOM content for scraping.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ],
  "host_permissions": ["https://*/*", "http://*/*"]
}
